# Copy to .env and fill from the output of `npx supabase status`.
# .env is gitignored — never commit real keys.

# --- Supabase (local defaults shown) ---
SUPABASE_URL=http://127.0.0.1:54321

# "anon key" from `supabase status`. Sent as the PostgREST apikey header.
SUPABASE_ANON_KEY=

# "JWT secret" from `supabase status`. Used to VERIFY the user's access token.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# "service_role key" from `supabase status`. Optional here — used ONLY for
# out-of-band admin/support tasks, NEVER to serve a user request.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Allowed CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173

# --- Agents (Phase 1) ---
# 07-reasoning-agent calls the Claude API. Key from the environment only, never
# hardcoded. Absent -> claims with issues escalate at the reasoning step.
ANTHROPIC_API_KEY=
# Optional: override the reasoning model (default: claude-opus-5).
REASONING_MODEL=claude-opus-5
