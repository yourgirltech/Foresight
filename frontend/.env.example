# Copy to .env and fill from `npx supabase status`.
# Only VITE_-prefixed vars are exposed to the browser. The anon key is safe to
# ship to the client — RLS is what protects the data, not key secrecy.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# FastAPI backend base URL.
VITE_API_BASE_URL=http://localhost:8000
